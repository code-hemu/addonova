{
  "manifest_version": 3,
  "name": "Simple Extension",
  "version": "0.1.0",
  "description": "Minimal test extension for addonova",
  "default_locale": "en",
  "icons": { "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_popup": "ui/popup.html",
    "default_icon": { "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": []
}
